@page "/tareas"
@inject IRepositorioTareas Repositorio
@inject IRepositorioContactos Contactos
@inject IRepositorioOportunidades Oportunidades

<PageTitle>Tareas · Vortex CRM</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Tareas</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddTask"
               Href="tareas/nueva">Nueva tarea</MudButton>
</MudStack>

@if (agenda is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (agenda.EstaVacia)
{
    <MudText Class="mud-text-secondary">
        Todavía no tienes tareas. Anota tus llamadas, visitas y seguimientos para no olvidar ninguno.
    </MudText>
}
else
{
    @if (agenda.Vencidas.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1" data-seccion="vencidas">
            <MudText Typo="Typo.h6" Color="Color.Error" Class="mb-1">Vencidas (@agenda.Vencidas.Count)</MudText>
            <ListaTareas Tareas="agenda.Vencidas" Nombres="nombres" Volver="tareas" AlCambiar="CargarAsync" />
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="1" data-seccion="hoy">
        <MudText Typo="Typo.h6" Class="mb-1">Hoy (@agenda.Hoy.Count)</MudText>
        @if (agenda.Hoy.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No tienes tareas para hoy.</MudText>
        }
        else
        {
            <ListaTareas Tareas="agenda.Hoy" Nombres="nombres" Volver="tareas" AlCambiar="CargarAsync" />
        }
    </MudPaper>

    @if (agenda.Proximas.Count > 0)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1" data-seccion="proximas">
            <MudText Typo="Typo.h6" Class="mb-1">Próximas (@agenda.Proximas.Count)</MudText>
            <ListaTareas Tareas="agenda.Proximas" Nombres="nombres" Volver="tareas" AlCambiar="CargarAsync" />
        </MudPaper>
    }

    @if (agenda.Completadas.Count > 0)
    {
        <MudExpansionPanels Elevation="1" data-seccion="completadas">
            <MudExpansionPanel Text="@($"Hechas ({agenda.Completadas.Count})")">
                <ListaTareas Tareas="agenda.Completadas" Nombres="nombres" Volver="tareas" AlCambiar="CargarAsync" />
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@code {
    private AgendaTareas? agenda;
    private IReadOnlyDictionary<Guid, string> nombres = new Dictionary<Guid, string>();

    protected override async Task OnInitializedAsync()
    {
        nombres = await NombresDeRegistros.CargarAsync(Contactos, Oportunidades);
        await CargarAsync();
    }

    private async Task CargarAsync() => agenda = AgendaTareas.Organizar(await Repositorio.ListarAsync(), FormatoPeru.Hoy());
}
