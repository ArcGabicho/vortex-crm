@page "/tareas/nueva"
@page "/tareas/{Id:guid}"
@using System.Text.RegularExpressions
@inject IRepositorioTareas Repositorio
@inject IRepositorioContactos Contactos
@inject IRepositorioOportunidades Oportunidades
@inject IServicioRecordatorios Recordatorios
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IDialogService Dialogos

<PageTitle>@Titulo · Vortex CRM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Titulo</MudText>

@if (noEncontrada)
{
    <MudAlert Severity="Severity.Warning">La tarea no existe o fue eliminada.</MudAlert>
}
else if (tarea is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="tarea.Titulo" Label="¿Qué hay que hacer?" Required
                              Placeholder="Ej.: Llamar para confirmar el pedido" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="TipoTarea" @bind-Value="tarea.Tipo" Label="Tipo">
                    @foreach (var tipo in TiposTarea.Todos)
                    {
                        <MudSelectItem T="TipoTarea" Value="tipo">@tipo.Nombre()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudDatePicker @bind-Date="Fecha" Label="Fecha" Culture="FormatoPeru.Cultura" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudTimePicker @bind-Time="Hora" Label="Hora (opcional)" AmPm Clearable Culture="FormatoPeru.Cultura" />
            </MudItem>
            @if (Recordatorios.Disponible)
            {
                <MudItem xs="12" sm="6">
                    <MudSelect T="int?" @bind-Value="tarea.AvisarMinutosAntes" Label="Avisarme">
                        <MudSelectItem T="int?" Value="@((int?)null)">Sin aviso</MudSelectItem>
                        @foreach (var opcion in Avisos.Para(tarea.Hora))
                        {
                            <MudSelectItem T="int?" Value="@opcion.MinutosAntes">@opcion.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid?" @bind-Value="tarea.EmpresaId" Label="Empresa">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin empresa</MudSelectItem>
                    @foreach (var empresa in empresas)
                    {
                        <MudSelectItem T="Guid?" Value="@empresa.Id">@empresa.NombreVisible</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid?" Value="tarea.ContactoId" ValueChanged="CambiarContacto" Label="Contacto">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin contacto</MudSelectItem>
                    @foreach (var contacto in contactos)
                    {
                        <MudSelectItem T="Guid?" Value="@contacto.Id">@contacto.NombreCompleto</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid?" Value="tarea.OportunidadId" ValueChanged="CambiarOportunidad" Label="Oportunidad">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin oportunidad</MudSelectItem>
                    @foreach (var oportunidad in OportunidadesDisponibles)
                    {
                        <MudSelectItem T="Guid?" Value="@oportunidad.Id">@oportunidad.Titulo</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="tarea.Notas" Label="Notas" Lines="3" Sizing="InputSizing.Auto" />
            </MudItem>
            @if (Id is not null)
            {
                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="Hecha" Color="Color.Success"
                               Label="@(tarea.Completada ? "Hecha" : "Pendiente")" />
                </MudItem>
            }
        </MudGrid>

        @if (errores.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @foreach (var error in errores)
                {
                    <div>@error</div>
                }
            </MudAlert>
        }

        <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Class="mt-4">
            @if (Id is not null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="EliminarAsync">Eliminar</MudButton>
            }
            <MudButton Variant="Variant.Text" Href="@Destino">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync">Guardar</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    // Al crear la tarea desde la pantalla de un cliente u oportunidad, llega ya vinculada
    [SupplyParameterFromQuery(Name = "empresa")] public Guid? EmpresaOrigen { get; set; }
    [SupplyParameterFromQuery(Name = "contacto")] public Guid? ContactoOrigen { get; set; }
    [SupplyParameterFromQuery(Name = "oportunidad")] public Guid? OportunidadOrigen { get; set; }

    /// <summary>A dónde regresar: "inicio", "tareas" o la pantalla de una empresa, contacto u oportunidad.</summary>
    [SupplyParameterFromQuery(Name = "volver")] public string? Volver { get; set; }

    private static readonly Regex DestinoPermitido =
        new("^(inicio|tareas|(empresas|contactos|oportunidades)/[0-9a-fA-F-]{36})$", RegexOptions.Compiled);

    private Tarea? tarea;
    private IReadOnlyList<Empresa> empresas = [];
    private IReadOnlyList<Contacto> contactos = [];
    private IReadOnlyList<Oportunidad> oportunidades = [];
    private bool noEncontrada;
    private List<string> errores = [];

    private string Titulo => Id is null ? "Nueva tarea" : "Editar tarea";

    /// <summary>
    /// Solo se aceptan pantallas de la app (nunca una dirección externa). Sin "volver", se
    /// regresa a la pantalla desde donde se creó la tarea o a la lista de tareas.
    /// </summary>
    private string Destino =>
        Volver is not null && DestinoPermitido.IsMatch(Volver) ? (Volver == "inicio" ? "" : Volver)
        : OportunidadOrigen is { } oportunidadId ? $"oportunidades/{oportunidadId}"
        : ContactoOrigen is { } contactoId ? $"contactos/{contactoId}"
        : EmpresaOrigen is { } empresaId ? $"empresas/{empresaId}"
        : "tareas";

    /// <summary>Las abiertas del cliente elegido (o todas las abiertas), más la ya vinculada.</summary>
    private IEnumerable<Oportunidad> OportunidadesDisponibles => oportunidades.Where(o =>
        o.Id == tarea!.OportunidadId
        || (o.Etapa.EstaAbierta() && (tarea.EmpresaId is null && tarea.ContactoId is null
            || o.EmpresaId == tarea.EmpresaId && tarea.EmpresaId is not null
            || o.ContactoId == tarea.ContactoId && tarea.ContactoId is not null)));

    private DateTime? Fecha
    {
        get => tarea?.Fecha.ToDateTime(TimeOnly.MinValue);
        set => tarea!.Fecha = value is null ? FormatoPeru.Hoy() : DateOnly.FromDateTime(value.Value);
    }

    private TimeSpan? Hora
    {
        get => tarea?.Hora?.ToTimeSpan();
        set
        {
            tarea!.Hora = value is null ? null : TimeOnly.FromTimeSpan(value.Value);

            // Si la anticipación elegida no existe para el nuevo caso (con o sin hora), se avisa el mismo día
            if (tarea.AvisarMinutosAntes is { } minutos && Avisos.Para(tarea.Hora).All(o => o.MinutosAntes != minutos))
            {
                tarea.AvisarMinutosAntes = 0;
            }
        }
    }

    private bool Hecha
    {
        get => tarea?.Completada == true;
        set
        {
            if (value)
            {
                tarea!.Completar(DateTimeOffset.UtcNow);
            }
            else
            {
                tarea!.Reabrir();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        empresas = await Contactos.ListarEmpresasAsync();
        contactos = await Contactos.ListarContactosAsync();
        oportunidades = await Oportunidades.ListarAsync();

        if (Id is not null)
        {
            tarea = await Repositorio.ObtenerAsync(Id.Value);
            noEncontrada = tarea is null;
            return;
        }

        tarea = new Tarea { EmpresaId = EmpresaOrigen };
        CambiarContacto(ContactoOrigen);
        CambiarOportunidad(OportunidadOrigen);
    }

    private void CambiarContacto(Guid? contactoId)
    {
        tarea!.ContactoId = contactoId;

        // Si el contacto trabaja en una empresa y todavía no se eligió una, se completa sola
        var empresaDelContacto = contactos.FirstOrDefault(c => c.Id == contactoId)?.EmpresaId;
        tarea.EmpresaId ??= empresaDelContacto;
    }

    private void CambiarOportunidad(Guid? oportunidadId)
    {
        tarea!.OportunidadId = oportunidadId;

        // La oportunidad trae a su cliente si la tarea todavía no tiene uno
        if (oportunidades.FirstOrDefault(o => o.Id == oportunidadId) is { } oportunidad
            && tarea.EmpresaId is null && tarea.ContactoId is null)
        {
            tarea.EmpresaId = oportunidad.EmpresaId;
            tarea.ContactoId = oportunidad.ContactoId;
        }
    }

    private async Task GuardarAsync()
    {
        errores = tarea!.Validar().ToList();
        if (errores.Count > 0)
        {
            return;
        }

        var sinPermiso = tarea.CrearRecordatorio(DateTimeOffset.UtcNow) is not null
            && Recordatorios.Disponible
            && !await Recordatorios.SolicitarPermisoAsync();

        await Repositorio.GuardarAsync(tarea);

        if (sinPermiso)
        {
            Snackbar.Add(
                "Tarea guardada, pero no podremos avisarte: activa las notificaciones de Vortex CRM en los ajustes del celular.",
                Severity.Warning);
        }
        else
        {
            Snackbar.Add("Tarea guardada.", Severity.Success);
        }

        Navegacion.NavigateTo(Destino);
    }

    private async Task EliminarAsync()
    {
        var confirmado = await Dialogos.ShowMessageBoxAsync(
            "Eliminar tarea",
            $"¿Eliminar \"{tarea!.Titulo}\"?",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmado == true)
        {
            await Repositorio.EliminarAsync(tarea.Id);
            Snackbar.Add("Tarea eliminada.", Severity.Success);
            Navegacion.NavigateTo(Destino);
        }
    }
}
