@page "/mi-negocio"
@using Vortex.Domain.Configuracion
@inject IRepositorioNegocio Repositorio
@inject IConsultaDocumentos ConsultaDocumentos
@inject ISnackbar Snackbar

<PageTitle>Mi negocio · Vortex CRM</PageTitle>

<MudText Typo="Typo.h4">Mi negocio</MudText>
<MudText Typo="Typo.body1" Class="mb-4 mud-text-secondary">Estos datos aparecen en tus cotizaciones.</MudText>

@if (negocio is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    @if (ConsultaDocumentos.EsDePrueba)
    {
        <MudAlert Severity="Severity.Info" Dense Class="mb-4">
            La consulta de RUC está en modo de prueba: los datos que se completan son inventados.
        </MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <CampoRuc Label="RUC (opcional)" Ruc="@negocio.Ruc" RucChanged="@(ruc => negocio.Ruc = ruc)"
                          Encontrado="AplicarDatosSunat" @bind-Buscando="buscando" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="negocio.RazonSocial" Label="Nombre o razón social" Required />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="negocio.NombreComercial" Label="Nombre comercial"
                              HelperText="Es el que se destaca en tus cotizaciones" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="RegimenTributario" @bind-Value="negocio.Regimen" Label="Régimen tributario"
                           HelperText="@AyudaRegimen">
                    @foreach (var regimen in Regimenes.Todos)
                    {
                        <MudSelectItem T="RegimenTributario" Value="regimen">@regimen.Nombre()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="negocio.Direccion" Label="Dirección" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <CampoUbigeo @bind-Codigo="negocio.Ubigeo" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="negocio.Telefono" Label="Celular / WhatsApp" InputType="InputType.Telephone" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="negocio.Email" Label="Correo" InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="negocio.CondicionesPredeterminadas" Label="Condiciones de tus cotizaciones"
                              Lines="3" Sizing="InputSizing.Auto"
                              Placeholder="Ej.: Pago 50 % adelantado. Entrega en 7 días hábiles."
                              HelperText="Se copian en cada cotización nueva; puedes cambiarlas en cada una" />
            </MudItem>
        </MudGrid>

        @if (errores.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @foreach (var error in errores)
                {
                    <div>@error</div>
                }
            </MudAlert>
        }

        <MudStack Row Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="buscando">Guardar</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private Negocio? negocio;
    private bool buscando;
    private List<string> errores = [];

    private string AyudaRegimen => negocio?.Regimen == RegimenTributario.NuevoRus
        ? "En el Nuevo RUS no se cobra IGV: tus cotizaciones saldrán sin IGV"
        : "Tus cotizaciones saldrán con precios que incluyen IGV; puedes cambiarlo en cada una";

    protected override async Task OnInitializedAsync() => negocio = await Repositorio.ObtenerAsync();

    private void AplicarDatosSunat(DatosRuc datos)
    {
        negocio!.RazonSocial = datos.RazonSocial;
        negocio.NombreComercial ??= datos.NombreComercial;
        negocio.Direccion = datos.Direccion;
        negocio.Ubigeo = datos.Ubigeo;
    }

    private async Task GuardarAsync()
    {
        errores = negocio!.Validar().ToList();
        if (errores.Count > 0)
        {
            return;
        }

        await Repositorio.GuardarAsync(negocio);
        Snackbar.Add("Datos del negocio guardados.", Severity.Success);
    }
}
