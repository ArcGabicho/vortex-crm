@page "/datos-y-sucursales"
@using Vortex.Domain.Configuracion
@inject IAlmacenConfiguracion Almacen
@inject IRepositorioNegocio Negocios
@inject ISnackbar Snackbar

<PageTitle>Datos y sucursales · Vortex CRM</PageTitle>

<div class="vx-cabecera">
    <MudText Typo="Typo.h4">Datos y sucursales</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
        Dónde guarda los datos esta instalación y qué locales tiene el negocio. Se protege con la clave de administrador.
    </MudText>
</div>

@if (configuracion is null || negocio is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (!configuracion.TieneClave)
{
    <MudPaper Class="pa-4 vx-angosto" Elevation="0" data-crear-clave>
        <MudText Typo="Typo.h6">Crea la clave de administrador</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Solo quien la tenga podrá cambiar dónde se guardan los datos y las sucursales. Anótala en un lugar seguro:
            si se pierde, habrá que reinstalar la app.
        </MudText>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="claveNueva" Label="Clave" InputType="InputType.Password" HelperText="Al menos 6 caracteres" />
            <MudTextField @bind-Value="confirmacion" Label="Repite la clave" InputType="InputType.Password" />
        </MudStack>
        <Errores Lista="errores" />
        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CrearClave">Crear clave</MudButton>
        </div>
    </MudPaper>
}
else if (!desbloqueado)
{
    <MudPaper Class="pa-4 vx-angosto" Elevation="0" data-desbloquear>
        <MudText Typo="Typo.h6" Class="mb-3">Escribe la clave de administrador</MudText>
        <MudTextField @bind-Value="clave" Label="Clave" InputType="InputType.Password" Immediate
                      OnKeyDown="@(e => e.Key == "Enter" ? Desbloquear() : Task.CompletedTask)" />
        <Errores Lista="errores" />
        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LockOpen" OnClick="Desbloquear">Entrar</MudButton>
        </div>
    </MudPaper>
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="0" data-modo>
        <MudText Typo="Typo.h6" Class="mb-2">Dónde se guardan los datos</MudText>
        <MudRadioGroup T="ModoDatos" @bind-Value="configuracion.Modo">
            <div class="vx-opcion-modo">
                <MudRadio T="ModoDatos" Value="ModoDatos.Local" Color="Color.Primary" Dense />
                <div>
                    <b>En este equipo</b>
                    <span>Base de datos SQLite propia. Para un negocio de una sola sucursal: no necesita internet ni instalar nada más.</span>
                </div>
            </div>
            <div class="vx-opcion-modo vx-deshabilitada">
                <MudRadio T="ModoDatos" Value="ModoDatos.Servidor" Color="Color.Primary" Dense Disabled />
                <div>
                    <b>En el servidor de Vortex <MudChip T="string" Size="Size.Small" Class="ml-1">Próximamente</MudChip></b>
                    <span>Todas las sucursales comparten los datos en SQL Server, a través del servidor de Vortex.</span>
                </div>
            </div>
        </MudRadioGroup>

        @if (configuracion.Modo != Almacen.ModoEnUso)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">Cierra y vuelve a abrir la app para usar el nuevo modo.</MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0" data-sucursales>
        <div class="vx-tarjeta-cabecera">
            <MudText Typo="Typo.h6">Sucursales</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness"
                       OnClick="AgregarSucursal">Agregar sucursal</MudButton>
        </div>

        @if (negocio.Sucursales.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Con un solo local no hace falta registrar sucursales: se usa la dirección de Mi negocio.
            </MudText>
        }

        @foreach (var sucursal in negocio.Sucursales)
        {
            <MudPaper @key="sucursal.Id" Outlined Class="pa-3 mb-3" data-sucursal>
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="sucursal.Nombre" Label="Nombre" Required />
                    </MudItem>
                    <MudItem xs="7" sm="3">
                        <MudTextField @bind-Value="sucursal.CodigoEstablecimiento" Label="Código SUNAT" MaxLength="4"
                                      InputMode="InputMode.numeric" HelperText="0000 = domicilio fiscal" />
                    </MudItem>
                    <MudItem xs="5" sm="3" Class="d-flex align-center justify-end">
                        <MudSwitch T="bool" @bind-Value="sucursal.Activa" Color="Color.Primary" Label="Activa" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="@($"Quitar {sucursal.Nombre}")"
                                       OnClick="() => QuitarSucursal(sucursal)" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="sucursal.Direccion" Label="Dirección" />
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <CampoUbigeo @bind-Codigo="sucursal.Ubigeo" HelperText="@null" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        @if (negocio.Sucursales.Any(s => s.Activa))
        {
            <div class="mt-2" data-sucursal-del-equipo>
                <MudSelect T="Guid?" @bind-Value="configuracion.SucursalId" Label="Este equipo es de la sucursal"
                           HelperText="Las cotizaciones y ventas que se hagan aquí serán de esa sucursal">
                    @foreach (var sucursal in negocio.Sucursales.Where(s => s.Activa))
                    {
                        <MudSelectItem T="Guid?" Value="sucursal.Id">@NombreDe(sucursal)</MudSelectItem>
                    }
                </MudSelect>
            </div>
        }
    </MudPaper>

    @if (cambiandoClave)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" data-cambiar-clave>
            <MudText Typo="Typo.h6" Class="mb-3">Cambiar la clave de administrador</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="claveNueva" Label="Clave nueva" InputType="InputType.Password" HelperText="Al menos 6 caracteres" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="confirmacion" Label="Repite la clave nueva" InputType="InputType.Password" />
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <Errores Lista="errores" />

    <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Class="mt-4">
        @if (!cambiandoClave)
        {
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Key" OnClick="() => cambiandoClave = true">Cambiar clave</MudButton>
        }
        <MudButton Variant="Variant.Text" OnClick="Bloquear">Salir</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync">Guardar</MudButton>
    </MudStack>
}

@code {
    private ConfiguracionInstalacion? configuracion;
    private Negocio? negocio;
    private bool desbloqueado;
    private bool cambiandoClave;
    private string? clave;
    private string? claveNueva;
    private string? confirmacion;
    private List<string> errores = [];

    protected override async Task OnInitializedAsync()
    {
        configuracion = Almacen.Cargar();
        negocio = await Negocios.ObtenerAsync();
    }

    private void CrearClave()
    {
        errores = ConfiguracionInstalacion.ValidarClaveNueva(claveNueva, confirmacion).ToList();
        if (errores.Count > 0)
        {
            return;
        }

        configuracion!.EstablecerClave(claveNueva!);
        Almacen.Guardar(configuracion);
        claveNueva = confirmacion = null;
        desbloqueado = true;
        Snackbar.Add("Clave creada.", Severity.Success);
    }

    private Task Desbloquear()
    {
        desbloqueado = configuracion!.VerificarClave(clave);
        errores = desbloqueado ? [] : ["La clave no es correcta."];
        clave = null;
        return Task.CompletedTask;
    }

    private async Task Bloquear()
    {
        // Lo que no se guardó se descarta
        desbloqueado = cambiandoClave = false;
        errores = [];
        configuracion = Almacen.Cargar();
        negocio = await Negocios.ObtenerAsync();
    }

    private void AgregarSucursal()
    {
        var primera = negocio!.Sucursales.Count == 0;
        negocio.Sucursales.Add(new Sucursal
        {
            Nombre = primera ? "Principal" : "",
            CodigoEstablecimiento = primera ? Sucursal.CodigoDomicilioFiscal : SiguienteCodigo(),
            Direccion = primera ? negocio.Direccion : null,
            Ubigeo = primera ? negocio.Ubigeo : null,
        });
    }

    private void QuitarSucursal(Sucursal sucursal)
    {
        negocio!.Sucursales.Remove(sucursal);
        if (configuracion!.SucursalId == sucursal.Id)
        {
            configuracion.SucursalId = null;
        }
    }

    private string SiguienteCodigo()
    {
        var mayor = negocio!.Sucursales.Select(s => int.TryParse(s.CodigoEstablecimiento, out var n) ? n : 0).DefaultIfEmpty(0).Max();
        return (mayor + 1).ToString("0000");
    }

    private static string NombreDe(Sucursal sucursal) =>
        $"{(string.IsNullOrWhiteSpace(sucursal.Nombre) ? "Sin nombre" : sucursal.Nombre)} ({sucursal.CodigoEstablecimiento})";

    private async Task GuardarAsync()
    {
        errores = [.. configuracion!.Validar(), .. negocio!.Validar()];
        if (cambiandoClave)
        {
            errores.AddRange(ConfiguracionInstalacion.ValidarClaveNueva(claveNueva, confirmacion));
        }

        if (configuracion.SucursalId is { } id && negocio.Sucursales.All(s => s.Id != id || !s.Activa))
        {
            configuracion.SucursalId = null;
        }

        if (errores.Count > 0)
        {
            return;
        }

        if (cambiandoClave)
        {
            configuracion.EstablecerClave(claveNueva!);
            claveNueva = confirmacion = null;
            cambiandoClave = false;
        }

        await Negocios.GuardarAsync(negocio);
        Almacen.Guardar(configuracion);
        Snackbar.Add("Configuración guardada.", Severity.Success);
    }
}
