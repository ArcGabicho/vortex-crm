@page "/productos"
@using Vortex.Domain.Catalogo
@using Vortex.Domain.Configuracion
@inject IRepositorioProductos Repositorio
@inject IRepositorioNegocio Negocios

<PageTitle>Productos · Vortex CRM</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Productos y servicios</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               Href="productos/nuevo">Nuevo producto</MudButton>
</MudStack>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField T="string" Value="filtro" ValueChanged="FiltrarAsync" Immediate DebounceInterval="300" Clearable
                  Placeholder="Buscar por nombre o código" Variant="Variant.Outlined" Style="min-width: 240px"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
    <MudSwitch T="bool" Value="mostrarInactivos" ValueChanged="CambiarInactivosAsync" Color="Color.Primary"
               Label="Mostrar inactivos" />
</MudStack>

@if (productos is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else if (productos.Count == 0)
{
    <MudText Class="mud-text-secondary">
        @(string.IsNullOrWhiteSpace(filtro)
            ? "Todavía no tienes productos. Regístralos para cotizar más rápido."
            : $"No hay productos que coincidan con \"{filtro}\".")
    </MudText>
}
else
{
    <MudPaper Elevation="1">
        <MudList T="string">
            @foreach (var producto in productos)
            {
                <MudListItem T="string" Href="@($"productos/{producto.Id}")" data-producto="@producto.Nombre"
                             Icon="@(producto.Tipo == TipoProducto.Servicio ? Icons.Material.Filled.Handyman : Icons.Material.Filled.Inventory2)">
                    <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="1">
                        <div>
                            <MudText Typo="Typo.body1">
                                @producto.Nombre
                                @if (!producto.Activo)
                                {
                                    <MudChip T="string" Size="Size.Small" Class="my-0">Inactivo</MudChip>
                                }
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Detalle(producto)</MudText>
                        </div>
                        <MudText Typo="Typo.body1"><b>@FormatoPeru.Soles(producto.Precio)</b></MudText>
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}

@code {
    private string? filtro;
    private bool mostrarInactivos;
    private bool sinIgv;
    private IReadOnlyList<Producto>? productos;

    protected override async Task OnInitializedAsync()
    {
        sinIgv = (await Negocios.ObtenerAsync()).ModoIgvPredeterminado == ModoIgv.NoAplica;
        await CargarAsync();
    }

    private async Task FiltrarAsync(string? valor)
    {
        filtro = valor;
        await CargarAsync();
    }

    private async Task CambiarInactivosAsync(bool valor)
    {
        mostrarInactivos = valor;
        await CargarAsync();
    }

    private async Task CargarAsync() => productos = await Repositorio.ListarAsync(filtro, mostrarInactivos);

    private string Detalle(Producto producto)
    {
        var igv = sinIgv ? null : producto.PrecioIncluyeIgv ? "con IGV" : "sin IGV";
        return string.Join(" · ", new[] { producto.Codigo, $"por {producto.Unidad}", igv }.Where(p => !string.IsNullOrWhiteSpace(p)));
    }
}
