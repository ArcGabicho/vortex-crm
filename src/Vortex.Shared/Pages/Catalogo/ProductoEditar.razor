@page "/productos/nuevo"
@page "/productos/{Id:guid}"
@using Vortex.Domain.Catalogo
@using Vortex.Domain.Configuracion
@inject IRepositorioProductos Repositorio
@inject IRepositorioNegocio Negocios
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IDialogService Dialogos

<PageTitle>@Titulo · Vortex CRM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Titulo</MudText>

@if (noEncontrado)
{
    <MudAlert Severity="Severity.Warning">El producto no existe o fue eliminado.</MudAlert>
}
else if (producto is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudSelect T="TipoProducto" Value="producto.Tipo" ValueChanged="CambiarTipo" Label="Tipo">
                    <MudSelectItem T="TipoProducto" Value="TipoProducto.Producto">Producto</MudSelectItem>
                    <MudSelectItem T="TipoProducto" Value="TipoProducto.Servicio">Servicio</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="producto.Nombre" Label="Nombre" Required
                              Placeholder="Ej.: Polo bordado con logo" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudTextField @bind-Value="producto.Codigo" Label="Código (opcional)" MaxLength="30" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudSelect T="string" @bind-Value="producto.Unidad" Label="Unidad">
                    @foreach (var unidad in UnidadesDisponibles)
                    {
                        <MudSelectItem T="string" Value="unidad.Codigo">@unidad.Codigo – @unidad.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="producto.Precio" Label="Precio" Min="0" Format="N2"
                                 Adornment="Adornment.Start" AdornmentText="S/" Culture="FormatoPeru.Cultura" HideSpinButtons />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="producto.Descripcion" Label="Descripción para cotizaciones (opcional)"
                              Lines="2" Sizing="InputSizing.Auto"
                              HelperText="Es el texto que aparece en la cotización; si la dejas vacía se usa el nombre" />
            </MudItem>
            <MudItem xs="12" sm="6">
                @if (sinIgv)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Tu negocio está en el Nuevo RUS: los precios no llevan IGV.
                    </MudText>
                }
                else
                {
                    <MudSwitch T="bool" @bind-Value="producto.PrecioIncluyeIgv" Color="Color.Primary"
                               Label="@(producto.PrecioIncluyeIgv ? "El precio incluye IGV" : "El precio no incluye IGV")" />
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="producto.Activo" Color="Color.Primary"
                           Label="@(producto.Activo ? "Disponible para cotizar" : "Inactivo: no aparece al cotizar")" />
            </MudItem>
        </MudGrid>

        @if (errores.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @foreach (var error in errores)
                {
                    <div>@error</div>
                }
            </MudAlert>
        }

        <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Class="mt-4">
            @if (Id is not null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="EliminarAsync">Eliminar</MudButton>
            }
            <MudButton Variant="Variant.Text" Href="productos">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync">Guardar</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Producto? producto;
    private bool noEncontrado;
    private bool sinIgv;
    private List<string> errores = [];

    private string Titulo => Id is null ? "Nuevo producto" : "Editar producto";

    /// <summary>Las unidades comunes, más la del producto si se registró con otra.</summary>
    private IEnumerable<UnidadMedida> UnidadesDisponibles =>
        Unidades.Comunes.Any(u => u.Codigo == producto?.Unidad) || string.IsNullOrWhiteSpace(producto?.Unidad)
            ? Unidades.Comunes
            : Unidades.Comunes.Append(new UnidadMedida(producto.Unidad, producto.Unidad));

    protected override async Task OnParametersSetAsync()
    {
        sinIgv = (await Negocios.ObtenerAsync()).ModoIgvPredeterminado == ModoIgv.NoAplica;

        if (Id is null)
        {
            producto = new Producto();
            return;
        }

        producto = await Repositorio.ObtenerAsync(Id.Value);
        noEncontrado = producto is null;
    }

    private void CambiarTipo(TipoProducto tipo)
    {
        // Si la unidad era la propuesta para el tipo anterior, se cambia por la del nuevo tipo
        if (producto!.Unidad == Unidades.PredeterminadaPara(producto.Tipo))
        {
            producto.Unidad = Unidades.PredeterminadaPara(tipo);
        }

        producto.Tipo = tipo;
    }

    private async Task GuardarAsync()
    {
        errores = producto!.Validar().ToList();
        if (!string.IsNullOrWhiteSpace(producto.Codigo) && await Repositorio.ExisteCodigoAsync(producto.Codigo, producto.Id))
        {
            errores.Add($"Ya tienes otro producto con el código {producto.Codigo}.");
        }

        if (errores.Count > 0)
        {
            return;
        }

        await Repositorio.GuardarAsync(producto);
        Snackbar.Add("Producto guardado.", Severity.Success);
        Navegacion.NavigateTo("productos");
    }

    private async Task EliminarAsync()
    {
        var confirmado = await Dialogos.ShowMessageBoxAsync(
            "Eliminar producto",
            $"¿Eliminar {producto!.Nombre}? Las cotizaciones donde ya aparece no cambian. Si solo dejaste de venderlo, puedes marcarlo como inactivo.",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmado == true)
        {
            await Repositorio.EliminarAsync(producto.Id);
            Snackbar.Add("Producto eliminado.", Severity.Success);
            Navegacion.NavigateTo("productos");
        }
    }
}
