@page "/cotizaciones/nueva"
@page "/cotizaciones/{Id:guid}"
@using Vortex.Domain.Catalogo
@using Vortex.Domain.Configuracion
@using Vortex.Shared.Servicios
@inject IRepositorioCotizaciones Cotizaciones
@inject IRepositorioOportunidades Oportunidades
@inject IRepositorioContactos Contactos
@inject IRepositorioNegocio Negocios
@inject IGeneradorPdfCotizaciones GeneradorPdf
@inject IServicioArchivos Archivos
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IDialogService Dialogos

<PageTitle>@Titulo · Vortex CRM</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudText Typo="Typo.h4">@Titulo</MudText>
    @if (cotizacion is not null && Id is not null)
    {
        <EstadoCotizacionChip Estado="cotizacion.Estado" />
    }
</MudStack>

@if (noEncontrada)
{
    <MudAlert Severity="Severity.Warning">La cotización no existe o fue eliminada.</MudAlert>
}
else if (cotizacion is null || negocio is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    @if (!negocio.EstaConfigurado)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Completa los datos de tu negocio para poder generar el PDF y enviarla.
            <MudLink Href="mi-negocio">Ir a Mi negocio</MudLink>
        </MudAlert>
    }

    @if (empresas.Count == 0 && contactos.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Para cotizar primero registra a tu cliente. <MudLink Href="contactos">Ir a contactos</MudLink>
        </MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Cliente</MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid?" @bind-Value="cotizacion.EmpresaId" Label="Empresa">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin empresa</MudSelectItem>
                    @foreach (var empresa in empresas)
                    {
                        <MudSelectItem T="Guid?" Value="@empresa.Id">@empresa.NombreVisible</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid?" Value="cotizacion.ContactoId" ValueChanged="CambiarContacto" Label="Contacto">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin contacto</MudSelectItem>
                    @foreach (var contacto in contactos)
                    {
                        <MudSelectItem T="Guid?" Value="@contacto.Id">@contacto.NombreCompleto</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid?" @bind-Value="cotizacion.OportunidadId" Label="Oportunidad del pipeline">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Ninguna</MudSelectItem>
                    @foreach (var oportunidad in OportunidadesDelCliente)
                    {
                        <MudSelectItem T="Guid?" Value="@oportunidad.Id">@oportunidad.Titulo</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudDatePicker @bind-Date="FechaEmision" Label="Fecha" Culture="FormatoPeru.Cultura" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="6" sm="4">
                <MudDatePicker @bind-Date="ValidaHasta" Label="Válida hasta" Culture="FormatoPeru.Cultura" DateFormat="dd/MM/yyyy" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="ModoIgv" @bind-Value="cotizacion.ModoIgv" Label="IGV">
                    @foreach (var modo in Enum.GetValues<ModoIgv>())
                    {
                        <MudSelectItem T="ModoIgv" Value="modo">@modo.Nombre()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Productos y servicios</MudText>

        @foreach (var linea in cotizacion.Lineas)
        {
            <MudPaper @key="linea" Outlined Class="pa-3 mb-3" data-linea>
                <MudGrid Spacing="2">
                    <MudItem xs="12">
                        <MudTextField @bind-Value="linea.Descripcion" Label="Descripción" Sizing="InputSizing.Auto" Lines="1" />
                    </MudItem>
                    <MudItem xs="4" sm="2">
                        <MudNumericField T="decimal" @bind-Value="linea.Cantidad" Label="Cantidad" Min="0" Format="0.##"
                                         Culture="FormatoPeru.Cultura" HideSpinButtons />
                    </MudItem>
                    <MudItem xs="3" sm="2">
                        <MudTextField @bind-Value="linea.Unidad" Label="Unidad" MaxLength="8" />
                    </MudItem>
                    <MudItem xs="5" sm="3">
                        <MudNumericField T="decimal" @bind-Value="linea.PrecioUnitario" Label="Precio unit." Min="0" Format="N2"
                                         Adornment="Adornment.Start" AdornmentText="S/" Culture="FormatoPeru.Cultura" HideSpinButtons />
                    </MudItem>
                    <MudItem xs="9" sm="4" Class="d-flex align-center">
                        <MudText Typo="Typo.body1">Importe: <b>@FormatoPeru.Soles(linea.Importe)</b></MudText>
                    </MudItem>
                    <MudItem xs="3" sm="1" Class="d-flex align-center justify-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Quitar línea" Color="Color.Error"
                                       OnClick="() => cotizacion.Lineas.Remove(linea)" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudStack Row Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inventory2"
                       OnClick="AgregarDelCatalogoAsync">Agregar del catálogo</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => cotizacion.Lineas.Add(new LineaCotizacion()))">Agregar producto o servicio</MudButton>
        </MudStack>

        <div class="d-flex justify-end mt-4">
            <MudSimpleTable Dense Elevation="0" Style="min-width: 260px">
                <tbody>
                    @if (cotizacion.ModoIgv != ModoIgv.NoAplica)
                    {
                        <tr>
                            <td>Subtotal</td>
                            <td style="text-align: right" data-total="subtotal">@FormatoPeru.Soles(cotizacion.Totales.Subtotal)</td>
                        </tr>
                        <tr>
                            <td>IGV (18 %)</td>
                            <td style="text-align: right" data-total="igv">@FormatoPeru.Soles(cotizacion.Totales.Igv)</td>
                        </tr>
                    }
                    <tr>
                        <td><b>Total</b></td>
                        <td style="text-align: right" data-total="total"><b>@FormatoPeru.Soles(cotizacion.Totales.Total)</b></td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </div>
        <MudText Typo="Typo.caption" Align="Align.Right" Class="mud-text-secondary d-block">
            SON: @MontoEnLetras.Soles(cotizacion.Totales.Total)
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="8">
                <MudTextField @bind-Value="cotizacion.Condiciones" Label="Condiciones" Lines="3" Sizing="InputSizing.Auto"
                              Placeholder="Forma de pago, tiempo de entrega, garantía..." />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="EstadoCotizacion" Value="cotizacion.Estado" ValueChanged="CambiarEstadoAsync" Label="Estado"
                           HelperText="Al enviarla o aceptarla, su oportunidad avanza en el pipeline">
                    @foreach (var estado in EstadosCotizacion.Todos)
                    {
                        <MudSelectItem T="EstadoCotizacion" Value="estado">@estado</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (errores.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">
            @foreach (var error in errores)
            {
                <div>@error</div>
            }
        </MudAlert>
    }

    <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Class="mt-4">
        @if (Id is not null)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="EliminarAsync">Eliminar</MudButton>
        }
        <MudButton Variant="Variant.Text" Href="cotizaciones">Volver</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync">Guardar</MudButton>
        @if (Id is not null)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Archivos.IconoPdf"
                       OnClick="EntregarPdfAsync" Disabled="@(generandoPdf || !negocio.EstaConfigurado)">
                @Archivos.EtiquetaPdf
            </MudButton>
            <MudTooltip Text="El cliente no tiene un celular registrado" Disabled="@(EnlaceWhatsApp is not null)">
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Custom.Brands.WhatsApp"
                           Href="@EnlaceWhatsApp" Target="_blank" OnClick="EnviarPorWhatsAppAsync"
                           Disabled="@(EnlaceWhatsApp is null || !negocio.EstaConfigurado)">
                    Enviar por WhatsApp
                </MudButton>
            </MudTooltip>
        }
    </MudStack>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    /// <summary>Al crear la cotización desde una oportunidad del pipeline: <c>?oportunidad={id}</c>.</summary>
    [SupplyParameterFromQuery(Name = "oportunidad")] public Guid? OportunidadOrigen { get; set; }

    private Cotizacion? cotizacion;
    private Negocio? negocio;
    private IReadOnlyList<Empresa> empresas = [];
    private IReadOnlyList<Contacto> contactos = [];
    private IReadOnlyList<Oportunidad> oportunidades = [];
    private Oportunidad? oportunidadModificada;
    private bool noEncontrada;
    private bool generandoPdf;
    private List<string> errores = [];

    private string Titulo => Id is null ? "Nueva cotización" : $"Cotización {cotizacion?.Codigo}";

    private Empresa? EmpresaElegida => empresas.FirstOrDefault(e => e.Id == cotizacion?.EmpresaId);

    private Contacto? ContactoElegido => contactos.FirstOrDefault(c => c.Id == cotizacion?.ContactoId);

    private IEnumerable<Oportunidad> OportunidadesDelCliente => oportunidades.Where(o =>
        o.Id == cotizacion!.OportunidadId
        || (cotizacion.EmpresaId is not null && o.EmpresaId == cotizacion.EmpresaId)
        || (cotizacion.ContactoId is not null && o.ContactoId == cotizacion.ContactoId));

    private DateTime? FechaEmision
    {
        get => cotizacion?.FechaEmision.ToDateTime(TimeOnly.MinValue);
        set
        {
            if (value is { } fecha)
            {
                cotizacion!.FechaEmision = DateOnly.FromDateTime(fecha);
            }
        }
    }

    private DateTime? ValidaHasta
    {
        get => cotizacion?.ValidaHasta.ToDateTime(TimeOnly.MinValue);
        set
        {
            if (value is { } fecha)
            {
                cotizacion!.ValidaHasta = DateOnly.FromDateTime(fecha);
            }
        }
    }

    /// <summary>El chat con el celular del cliente y el resumen de la cotización ya escrito.</summary>
    private string? EnlaceWhatsApp
    {
        get
        {
            if (cotizacion is null || negocio is null || (EmpresaElegida is null && ContactoElegido is null))
            {
                return null;
            }

            var cliente = ClienteCotizacion.Crear(EmpresaElegida, ContactoElegido);
            var saludo = ContactoElegido is null ? null : FormatoPeru.Cultura.TextInfo.ToTitleCase(ContactoElegido.Nombres.ToLower(FormatoPeru.Cultura));
            return MensajeWhatsApp.Enlace(cliente.Telefono, MensajeWhatsApp.Cotizacion(cotizacion, negocio, saludo));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        negocio = await Negocios.ObtenerAsync();
        empresas = await Contactos.ListarEmpresasAsync();
        contactos = await Contactos.ListarContactosAsync();
        oportunidades = await Oportunidades.ListarAsync();
        oportunidadModificada = null;
        errores = [];

        if (Id is not null)
        {
            cotizacion = await Cotizaciones.ObtenerAsync(Id.Value);
            noEncontrada = cotizacion is null;
            return;
        }

        cotizacion = new Cotizacion { ModoIgv = negocio.ModoIgvPredeterminado, Condiciones = negocio.CondicionesPredeterminadas };

        // Desde el pipeline: mismo cliente y una primera línea con el título y el monto de la oportunidad
        if (oportunidades.FirstOrDefault(o => o.Id == OportunidadOrigen) is { } origen)
        {
            cotizacion.OportunidadId = origen.Id;
            cotizacion.EmpresaId = origen.EmpresaId;
            cotizacion.ContactoId = origen.ContactoId;
            cotizacion.Lineas.Add(new LineaCotizacion { Descripcion = origen.Titulo, PrecioUnitario = origen.Monto });
        }
        else
        {
            cotizacion.Lineas.Add(new LineaCotizacion());
        }
    }

    private void CambiarContacto(Guid? contactoId)
    {
        cotizacion!.ContactoId = contactoId;

        var empresaDelContacto = contactos.FirstOrDefault(c => c.Id == contactoId)?.EmpresaId;
        if (cotizacion.EmpresaId is null && empresaDelContacto is not null)
        {
            cotizacion.EmpresaId = empresaDelContacto;
        }
    }

    private async Task CambiarEstadoAsync(EstadoCotizacion estado)
    {
        var oportunidad = cotizacion!.OportunidadId is { } id ? await Oportunidades.ObtenerAsync(id) : null;
        if (cotizacion.CambiarEstado(estado, oportunidad, DateTimeOffset.UtcNow))
        {
            oportunidadModificada = oportunidad;
        }
    }

    private async Task GuardarAsync()
    {
        if (!await GuardarInternoAsync())
        {
            return;
        }

        Snackbar.Add($"Cotización {cotizacion!.Codigo} guardada.", Severity.Success);
        if (Id is null)
        {
            // Ya guardada, se abre con su número para poder generar el PDF y enviarla
            Navegacion.NavigateTo($"cotizaciones/{cotizacion.Id}", replace: true);
        }
    }

    private async Task<bool> GuardarInternoAsync()
    {
        errores = cotizacion!.Validar().ToList();
        if (errores.Count > 0)
        {
            return false;
        }

        await Cotizaciones.GuardarAsync(cotizacion);

        if (oportunidadModificada is not null)
        {
            await Oportunidades.GuardarAsync(oportunidadModificada);
            Snackbar.Add($"La oportunidad \"{oportunidadModificada.Titulo}\" pasó a {oportunidadModificada.Etapa.Nombre()}.", Severity.Info);
            oportunidadModificada = null;
        }

        return true;
    }

    private async Task EntregarPdfAsync()
    {
        if (!await GuardarInternoAsync())
        {
            return;
        }

        generandoPdf = true;
        try
        {
            var cliente = ClienteCotizacion.Crear(EmpresaElegida, ContactoElegido);
            var copia = cotizacion!.Clonar();

            // Se genera fuera del hilo de la interfaz para que la app no se congele en celulares modestos
            var pdf = await Task.Run(() => GeneradorPdf.Generar(copia, negocio!, cliente));
            await Archivos.EntregarAsync($"{copia.Codigo}.pdf", "application/pdf", pdf);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo generar el PDF. Inténtalo de nuevo.", Severity.Error);
        }
        finally
        {
            generandoPdf = false;
        }
    }

    /// <summary>El enlace abre WhatsApp; además se guarda la cotización y se marca como enviada.</summary>
    private async Task AgregarDelCatalogoAsync()
    {
        var parametros = new DialogParameters<SelectorProductoDialog> { { d => d.ModoIgv, cotizacion!.ModoIgv } };
        var opciones = new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true };

        var dialogo = await Dialogos.ShowAsync<SelectorProductoDialog>("Agregar del catálogo", parametros, opciones);
        if (await dialogo.Result is { Canceled: false, Data: Producto producto })
        {
            cotizacion.AgregarLinea(producto.CrearLinea(cotizacion.ModoIgv));
        }
    }

    private async Task EnviarPorWhatsAppAsync()
    {
        if (cotizacion!.Estado == EstadoCotizacion.Borrador)
        {
            await CambiarEstadoAsync(EstadoCotizacion.Enviada);
        }

        await GuardarInternoAsync();
    }

    private async Task EliminarAsync()
    {
        var confirmado = await Dialogos.ShowMessageBoxAsync(
            "Eliminar cotización",
            $"¿Eliminar la cotización {cotizacion!.Codigo}?",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmado == true)
        {
            await Cotizaciones.EliminarAsync(cotizacion.Id);
            Snackbar.Add("Cotización eliminada.", Severity.Success);
            Navegacion.NavigateTo("cotizaciones");
        }
    }
}
