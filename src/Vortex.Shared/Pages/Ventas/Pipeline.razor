@page "/pipeline"
@inject IRepositorioOportunidades Oportunidades
@inject IRepositorioContactos Contactos
@inject ISnackbar Snackbar

<PageTitle>Pipeline · Vortex CRM</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Pipeline de ventas</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               Href="oportunidades/nueva">Nueva oportunidad</MudButton>
</MudStack>

@if (oportunidades is null || resumen is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    <MudGrid Class="mb-4" Spacing="2">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">En curso</MudText>
                <MudText Typo="Typo.h5" data-resumen="en-curso">@FormatoPeru.Soles(resumen.MontoEnCurso)</MudText>
                <MudText Typo="Typo.caption">@Plural(resumen.CantidadEnCurso, "oportunidad abierta", "oportunidades abiertas")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Ganado</MudText>
                <MudText Typo="Typo.h5" data-resumen="ganado">@FormatoPeru.Soles(resumen.PorEtapa[EtapaOportunidad.Ganado].Monto)</MudText>
                <MudText Typo="Typo.caption">@Plural(resumen.PorEtapa[EtapaOportunidad.Ganado].Cantidad, "venta", "ventas")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Tasa de cierre</MudText>
                <MudText Typo="Typo.h5" data-resumen="tasa">@(resumen.TasaDeCierre?.ToString("P0", FormatoPeru.Cultura) ?? "—")</MudText>
                <MudText Typo="Typo.caption">ganadas sobre cerradas</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (oportunidades.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Todavía no tienes oportunidades. Crea la primera para empezar a seguir tus ventas.
        </MudAlert>
    }

    <div class="tablero">
        <MudDropContainer T="Oportunidad" @ref="contenedor" Items="oportunidades" Class="columnas"
                          ItemsSelector="@((oportunidad, zona) => oportunidad.Etapa.ToString() == zona)"
                          ItemDropped="AlSoltarAsync">
            <ChildContent>
                @foreach (var etapa in Etapas.Todas)
                {
                    var totales = resumen.PorEtapa[etapa];
                    <MudDropZone T="Oportunidad" Identifier="@etapa.ToString()" Class="columna" data-etapa="@etapa">
                        <div class="cabecera">
                            <MudText Typo="Typo.subtitle1"><b>@etapa.Nombre()</b> (@totales.Cantidad)</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@FormatoPeru.Soles(totales.Monto)</MudText>
                        </div>
                    </MudDropZone>
                }
            </ChildContent>
            <ItemRenderer>
                <MudCard Elevation="1" Class="tarjeta">
                    <MudCardContent Class="pa-3">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="1">
                            <MudLink Href="@($"oportunidades/{context.Id}")" Typo="Typo.body1">@context.Titulo</MudLink>
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense
                                     AriaLabel="Mover oportunidad" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                @foreach (var destino in Etapas.Todas.Where(e => e != context.Etapa))
                                {
                                    <MudMenuItem OnClick="() => MoverAsync(context, destino)">Mover a @destino.Nombre()</MudMenuItem>
                                }
                            </MudMenu>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@NombreCliente(context)</MudText>
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-1">
                            <MudText Typo="Typo.body2"><b>@FormatoPeru.Soles(context.Monto)</b></MudText>
                            @if (context.FechaCierreEstimada is { } fecha)
                            {
                                <MudText Typo="Typo.caption" Color="@(context.EstaVencida(hoy) ? Color.Error : Color.Default)"
                                         title="Fecha estimada de cierre">
                                    @fecha.ToString("d MMM", FormatoPeru.Cultura)
                                </MudText>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </ItemRenderer>
        </MudDropContainer>
    </div>
}

@code {
    private MudDropContainer<Oportunidad>? contenedor;
    private List<Oportunidad>? oportunidades;
    private ResumenPipeline? resumen;
    private Dictionary<Guid, string> nombresEmpresas = [];
    private Dictionary<Guid, string> nombresContactos = [];
    private readonly DateOnly hoy = FormatoPeru.Hoy();

    protected override async Task OnInitializedAsync()
    {
        nombresEmpresas = (await Contactos.ListarEmpresasAsync()).ToDictionary(e => e.Id, e => e.NombreVisible);
        nombresContactos = (await Contactos.ListarContactosAsync()).ToDictionary(c => c.Id, c => c.NombreCompleto);
        oportunidades = (await Oportunidades.ListarAsync()).ToList();
        resumen = ResumenPipeline.Calcular(oportunidades);
    }

    private async Task AlSoltarAsync(MudItemDropInfo<Oportunidad> info)
    {
        if (info.Item is not null && Enum.TryParse<EtapaOportunidad>(info.DropzoneIdentifier, out var destino))
        {
            await MoverAsync(info.Item, destino);
        }
    }

    private async Task MoverAsync(Oportunidad oportunidad, EtapaOportunidad destino)
    {
        if (oportunidad.Etapa == destino)
        {
            return;
        }

        oportunidad.CambiarEtapa(destino, DateTimeOffset.UtcNow);
        await Oportunidades.GuardarAsync(oportunidad);

        resumen = ResumenPipeline.Calcular(oportunidades!);
        contenedor?.Refresh();

        if (destino == EtapaOportunidad.Perdido)
        {
            Snackbar.Add("Marcada como perdida. Puedes anotar el motivo al editarla.", Severity.Info);
        }
    }

    private string NombreCliente(Oportunidad oportunidad)
    {
        var empresa = oportunidad.EmpresaId is { } empresaId ? nombresEmpresas.GetValueOrDefault(empresaId) : null;
        var contacto = oportunidad.ContactoId is { } contactoId ? nombresContactos.GetValueOrDefault(contactoId) : null;
        return string.Join(" · ", new[] { empresa, contacto }.Where(n => n is not null));
    }

    private static string Plural(int cantidad, string singular, string plural) =>
        $"{cantidad} {(cantidad == 1 ? singular : plural)}";
}
