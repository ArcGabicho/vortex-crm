@page "/cotizaciones"
@using Vortex.Domain.Configuracion
@inject IRepositorioCotizaciones Repositorio
@inject IRepositorioContactos Contactos
@inject IRepositorioNegocio Negocios

<PageTitle>Cotizaciones · Vortex CRM</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Cotizaciones</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               Href="cotizaciones/nueva">Nueva cotización</MudButton>
</MudStack>

@if (cotizaciones is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    @if (!negocioConfigurado)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Completa los datos de tu negocio para que aparezcan en tus cotizaciones.
            <MudLink Href="mi-negocio">Ir a Mi negocio</MudLink>
        </MudAlert>
    }

    @if (cotizaciones.Count == 0)
    {
        <MudText Class="mud-text-secondary">Todavía no tienes cotizaciones.</MudText>
    }
    else
    {
        <MudPaper Elevation="1">
            <MudList T="string">
                @foreach (var cotizacion in cotizaciones)
                {
                    <MudListItem T="string" Href="@($"cotizaciones/{cotizacion.Id}")" Icon="@Icons.Material.Filled.RequestQuote">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="1">
                            <div>
                                <MudText Typo="Typo.body1">@cotizacion.Codigo · @NombreCliente(cotizacion)</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @cotizacion.FechaEmision.ToString("dd/MM/yyyy", FormatoPeru.Cultura) · @FormatoPeru.Soles(cotizacion.Totales.Total)
                                </MudText>
                            </div>
                            <EstadoCotizacionChip Estado="cotizacion.Estado" />
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
}

@code {
    private IReadOnlyList<Cotizacion>? cotizaciones;
    private Dictionary<Guid, string> nombresEmpresas = [];
    private Dictionary<Guid, string> nombresContactos = [];
    private bool negocioConfigurado;

    protected override async Task OnInitializedAsync()
    {
        negocioConfigurado = (await Negocios.ObtenerAsync()).EstaConfigurado;
        nombresEmpresas = (await Contactos.ListarEmpresasAsync()).ToDictionary(e => e.Id, e => e.NombreVisible);
        nombresContactos = (await Contactos.ListarContactosAsync()).ToDictionary(c => c.Id, c => c.NombreCompleto);
        cotizaciones = await Repositorio.ListarAsync();
    }

    private string NombreCliente(Cotizacion cotizacion) =>
        (cotizacion.EmpresaId is { } empresaId ? nombresEmpresas.GetValueOrDefault(empresaId) : null)
        ?? (cotizacion.ContactoId is { } contactoId ? nombresContactos.GetValueOrDefault(contactoId) : null)
        ?? "Sin cliente";
}
