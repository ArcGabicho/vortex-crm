@page "/oportunidades/nueva"
@page "/oportunidades/{Id:guid}"
@inject IRepositorioOportunidades Oportunidades
@inject IRepositorioContactos Contactos
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IDialogService Dialogos
@inject IRepositorioCotizaciones Cotizaciones
@inject IRepositorioTareas Tareas

<PageTitle>@Titulo · Vortex CRM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Titulo</MudText>

@if (noEncontrada)
{
    <MudAlert Severity="Severity.Warning">La oportunidad no existe o fue eliminada.</MudAlert>
}
else if (oportunidad is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    @if (empresas.Count == 0 && contactos.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Para crear una oportunidad primero registra a tu cliente.
            <MudLink Href="contactos">Ir a contactos</MudLink>
        </MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="oportunidad.Titulo" Label="Título" Required
                              Placeholder="Ej.: 50 polos bordados para el aniversario" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" @bind-Value="oportunidad.EmpresaId" Label="Empresa">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin empresa</MudSelectItem>
                    @foreach (var empresa in empresas)
                    {
                        <MudSelectItem T="Guid?" Value="@empresa.Id">@empresa.NombreVisible</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" Value="oportunidad.ContactoId" ValueChanged="CambiarContacto" Label="Contacto">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin contacto</MudSelectItem>
                    @foreach (var contacto in contactos)
                    {
                        <MudSelectItem T="Guid?" Value="@contacto.Id">@contacto.NombreCompleto</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="oportunidad.Monto" Label="Monto estimado (con IGV)"
                                 Adornment="Adornment.Start" AdornmentText="S/" Min="0" Format="N2"
                                 Culture="FormatoPeru.Cultura" HideSpinButtons />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="EtapaOportunidad" Value="oportunidad.Etapa" ValueChanged="CambiarEtapa" Label="Etapa">
                    @foreach (var etapa in Etapas.Todas)
                    {
                        <MudSelectItem T="EtapaOportunidad" Value="etapa">@etapa.Nombre()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="FechaCierre" Label="Fecha estimada de cierre" Clearable
                               Culture="FormatoPeru.Cultura" DateFormat="dd/MM/yyyy" />
            </MudItem>
            @if (oportunidad.Etapa == EtapaOportunidad.Perdido)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="oportunidad.MotivoPerdida" Label="Motivo de la pérdida"
                                  Placeholder="Ej.: eligió otro proveedor por precio" />
                </MudItem>
            }
            <MudItem xs="12">
                <MudTextField @bind-Value="oportunidad.Notas" Label="Notas" Lines="3" Sizing="InputSizing.Auto" />
            </MudItem>
        </MudGrid>

        @if (errores.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @foreach (var error in errores)
                {
                    <div>@error</div>
                }
            </MudAlert>
        }

        <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Class="mt-4">
            @if (Id is not null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="EliminarAsync">Eliminar</MudButton>
            }
            <MudButton Variant="Variant.Text" Href="pipeline">Cancelar</MudButton>
            @if (Id is not null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RequestQuote"
                           Href="@($"cotizaciones/nueva?oportunidad={Id}")">Crear cotización</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync">Guardar</MudButton>
        </MudStack>
    </MudPaper>

    @if (Id is not null)
    {
        <TareasDe RelacionadoId="Id.Value" Parametro="oportunidad" Volver="@($"oportunidades/{Id}")" />
    }
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Oportunidad? oportunidad;
    private IReadOnlyList<Empresa> empresas = [];
    private IReadOnlyList<Contacto> contactos = [];
    private bool noEncontrada;
    private List<string> errores = [];

    private string Titulo => Id is null ? "Nueva oportunidad" : "Editar oportunidad";

    private DateTime? FechaCierre
    {
        get => oportunidad?.FechaCierreEstimada?.ToDateTime(TimeOnly.MinValue);
        set => oportunidad!.FechaCierreEstimada = value is null ? null : DateOnly.FromDateTime(value.Value);
    }

    protected override async Task OnParametersSetAsync()
    {
        empresas = await Contactos.ListarEmpresasAsync();
        contactos = await Contactos.ListarContactosAsync();

        if (Id is null)
        {
            oportunidad = new Oportunidad();
            return;
        }

        oportunidad = await Oportunidades.ObtenerAsync(Id.Value);
        noEncontrada = oportunidad is null;
    }

    private void CambiarContacto(Guid? contactoId)
    {
        oportunidad!.ContactoId = contactoId;

        // Si el contacto trabaja en una empresa y todavía no se eligió una, se completa sola
        var empresaDelContacto = contactos.FirstOrDefault(c => c.Id == contactoId)?.EmpresaId;
        if (oportunidad.EmpresaId is null && empresaDelContacto is not null)
        {
            oportunidad.EmpresaId = empresaDelContacto;
        }
    }

    private void CambiarEtapa(EtapaOportunidad etapa) => oportunidad!.CambiarEtapa(etapa, DateTimeOffset.UtcNow);

    private async Task GuardarAsync()
    {
        errores = oportunidad!.Validar().ToList();
        if (errores.Count > 0)
        {
            return;
        }

        await Oportunidades.GuardarAsync(oportunidad);
        Snackbar.Add("Oportunidad guardada.", Severity.Success);
        Navegacion.NavigateTo("pipeline");
    }

    private async Task EliminarAsync()
    {
        var confirmado = await Dialogos.ShowMessageBoxAsync(
            "Eliminar oportunidad",
            $"¿Eliminar \"{oportunidad!.Titulo}\"? Sus cotizaciones se conservan.",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmado == true)
        {
            await Oportunidades.EliminarAsync(oportunidad.Id);
            await Cotizaciones.DesvincularOportunidadAsync(oportunidad.Id);
            await Tareas.DesvincularAsync(oportunidad.Id);
            Snackbar.Add("Oportunidad eliminada.", Severity.Success);
            Navegacion.NavigateTo("pipeline");
        }
    }
}
