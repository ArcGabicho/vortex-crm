@page "/"
@using System.Globalization
@inject IRepositorioTareas Tareas
@inject IRepositorioContactos Contactos
@inject IRepositorioOportunidades Oportunidades
@inject IRepositorioCotizaciones Cotizaciones

<PageTitle>Inicio · Vortex CRM</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="vx-cabecera">
    <div>
        <div class="vx-ruta">Vortex CRM / Inicio</div>
        <MudText Typo="Typo.h4">Panel principal</MudText>
    </div>
    <div class="vx-acciones">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="contactos/nuevo">Nuevo contacto</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Href="cotizaciones/nueva">Nueva cotización</MudButton>
    </div>
</MudStack>

@if (agenda is null || resumen is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="3">
        @foreach (var kpi in Indicadores())
        {
            <MudItem xs="6" sm="4" xl="2">
                <div class="vx-kpi" data-kpi="@kpi.Etiqueta">
                    <div class="vx-kpi-icono"><MudIcon Icon="@kpi.Icono" /></div>
                    <div>
                        <div class="vx-kpi-etiqueta">@kpi.Etiqueta</div>
                        <div class="vx-kpi-valor">@kpi.Valor</div>
                    </div>
                </div>
            </MudItem>
        }

        <MudItem xs="12" md="7">
            <div class="vx-tarjeta" data-ventas-mensuales>
                <h2>Ventas ganadas por mes</h2>
                <div class="vx-grafico" role="img" aria-label="Ventas ganadas por mes">
                    <div class="vx-grafico-y">
                        @foreach (var marca in MarcasDelEje)
                        {
                            <span style="top: @Num(YDe(maximoMensual * marca))%">@Abreviar(maximoMensual * marca)</span>
                        }
                    </div>
                    <div class="vx-grafico-area">
                        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                            @foreach (var marca in MarcasDelEje)
                            {
                                var y = Num(YDe(maximoMensual * marca));
                                <line class="eje" x1="0" x2="100" y1="@y" y2="@y" vector-effect="non-scaling-stroke" />
                            }
                            <path class="curva" d="@RutaDeLaCurva()" vector-effect="non-scaling-stroke" />
                        </svg>
                        @for (var i = 0; i < ventas.Count; i++)
                        {
                            <span class="vx-grafico-punto" style="left: @Num(XDe(i))%; top: @Num(YDe(ventas[i].Monto))%"
                                  title="@NombreMes(ventas[i].Mes): @FormatoPeru.Soles(ventas[i].Monto) (@ventas[i].Cantidad)"></span>
                        }
                    </div>
                    <div class="vx-grafico-x">
                        @for (var i = 0; i < ventas.Count; i++)
                        {
                            <span style="left: @Num(XDe(i))%">@NombreMes(ventas[i].Mes)</span>
                        }
                    </div>
                </div>
            </div>
        </MudItem>

        <MudItem xs="12" md="5">
            <div class="vx-tarjeta" data-pipeline>
                <h2>Pipeline por etapa</h2>
                @foreach (var etapa in EtapasMostradas)
                {
                    var r = resumen.PorEtapa[etapa];
                    var ancho = maximoEtapa == 0 ? 0 : (double)(r.Monto / maximoEtapa) * 100;
                    <div class="vx-barra-fila" data-etapa="@etapa.Nombre()">
                        <span>@etapa.Nombre()</span>
                        <div class="vx-barra-pista"><div class="vx-barra-relleno" style="width: @Num(ancho)%"></div></div>
                        <span class="vx-barra-valor">@r.Cantidad · @Abreviar(r.Monto)</span>
                    </div>
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="pipeline" Class="ml-n2">Abrir pipeline</MudButton>
            </div>
        </MudItem>

        <MudItem xs="12" md="5" lg="4">
            <div class="vx-tarjeta" data-para-hoy>
                <div class="vx-tarjeta-cabecera">
                    <h2>Para hoy</h2>
                    <div class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.AddTask" Color="Color.Primary" Size="Size.Small"
                                       Href="tareas/nueva?volver=inicio" aria-label="Nueva tarea" />
                        <MudButton Variant="Variant.Text" Size="Size.Small" Href="tareas">Ver todas</MudButton>
                    </div>
                </div>

                @if (agenda.ParaHoy.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        No tienes tareas pendientes para hoy.@(agenda.Proximas.Count > 0 ? $" La próxima: {agenda.Proximas[0].Titulo} ({FormatoPeru.FechaRelativa(agenda.Proximas[0].Fecha, hoy).ToLower(FormatoPeru.Cultura)})." : "")
                    </MudText>
                }
                else
                {
                    <ListaTareas Tareas="agenda.ParaHoy" Nombres="nombres" Volver="inicio" AlCambiar="CargarAsync" />
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="7" lg="4">
            <div class="vx-tarjeta" data-cotizaciones-estado>
                <h2>Cotizaciones por estado</h2>
                @if (cotizaciones.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Todavía no tienes cotizaciones.</MudText>
                }
                else
                {
                    <div class="vx-dona-caja">
                        <div class="vx-dona" style="background: @Dona()">
                            <div class="vx-dona-total">@cotizaciones.Count<small>cotizaciones</small></div>
                        </div>
                        <div class="vx-leyenda">
                            @foreach (var estado in EstadosCotizacion.Todos)
                            {
                                <div><i style="background: @ColorDe(estado)"></i>@estado: @cotizaciones.Count(c => c.Estado == estado)</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </MudItem>

        <MudItem xs="12" lg="4">
            <div class="vx-tarjeta" data-proximos-cierres>
                <h2>Próximos cierres</h2>
                @if (proximosCierres.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No hay oportunidades abiertas con fecha de cierre.</MudText>
                }
                @foreach (var oportunidad in proximosCierres)
                {
                    <a class="vx-fila" href="oportunidades/@oportunidad.Id">
                        <div class="vx-fila-principal">
                            <b>@oportunidad.Titulo</b>
                            <span>@(ClienteDe(oportunidad.EmpresaId, oportunidad.ContactoId))</span>
                        </div>
                        <div class="vx-fila-lado">
                            @FormatoPeru.Soles(oportunidad.Monto)
                            <span style="@(oportunidad.EstaVencida(hoy) ? "color: var(--mud-palette-error)" : null)">@FormatoPeru.FechaRelativa(oportunidad.FechaCierreEstimada!.Value, hoy)</span>
                        </div>
                    </a>
                }
            </div>
        </MudItem>

        <MudItem xs="12">
            <div class="vx-tarjeta" data-cotizaciones-recientes>
                <div class="vx-tarjeta-cabecera">
                    <h2>Cotizaciones recientes</h2>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Href="cotizaciones">Ver todas</MudButton>
                </div>
                @if (cotizaciones.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Aquí aparecerán tus últimas cotizaciones.</MudText>
                }
                else
                {
                    <div class="vx-tabla-caja">
                        <table class="vx-tabla">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Cliente</th>
                                    <th>Estado</th>
                                    <th class="vx-oculto-movil">Emisión</th>
                                    <th class="num">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cotizacion in cotizaciones.Take(5))
                                {
                                    <tr>
                                        <td class="vx-c-codigo"><a href="cotizaciones/@cotizacion.Id">@cotizacion.Codigo</a></td>
                                        <td class="vx-c-cliente">@ClienteDe(cotizacion.EmpresaId, cotizacion.ContactoId)</td>
                                        <td class="vx-c-estado"><EstadoCotizacionChip Estado="cotizacion.Estado" /></td>
                                        <td class="vx-oculto-movil">@cotizacion.FechaEmision.ToString("d MMM yyyy", FormatoPeru.Cultura)</td>
                                        <td class="num vx-c-total">@FormatoPeru.Soles(cotizacion.Totales.Total)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </MudItem>
    </MudGrid>
}

@code {
    private sealed record Indicador(string Etiqueta, string Valor, string Icono);

    private static readonly decimal[] MarcasDelEje = [0m, 0.25m, 0.5m, 0.75m, 1m];

    private static readonly EtapaOportunidad[] EtapasMostradas =
        [EtapaOportunidad.Prospecto, EtapaOportunidad.Cotizado, EtapaOportunidad.Negociacion, EtapaOportunidad.Ganado];

    private readonly DateOnly hoy = FormatoPeru.Hoy();
    private AgendaTareas? agenda;
    private ResumenPipeline? resumen;
    private IReadOnlyDictionary<Guid, string> nombres = new Dictionary<Guid, string>();
    private IReadOnlyList<Cotizacion> cotizaciones = [];
    private IReadOnlyList<VentaMes> ventas = [];
    private IReadOnlyList<Oportunidad> proximosCierres = [];
    private decimal maximoMensual = 1;
    private decimal maximoEtapa;

    protected override async Task OnInitializedAsync()
    {
        nombres = await NombresDeRegistros.CargarAsync(Contactos, Oportunidades);

        var oportunidades = await Oportunidades.ListarAsync();
        resumen = ResumenPipeline.Calcular(oportunidades);
        ventas = VentasMensuales.Ultimos(oportunidades, hoy);
        maximoMensual = EscalaRedonda(ventas.Max(v => v.Monto));
        maximoEtapa = EtapasMostradas.Max(e => resumen.PorEtapa[e].Monto);
        proximosCierres = oportunidades
            .Where(o => o.Etapa.EstaAbierta() && o.FechaCierreEstimada is not null)
            .OrderBy(o => o.FechaCierreEstimada)
            .Take(4)
            .ToList();
        cotizaciones = await Cotizaciones.ListarAsync();

        await CargarAsync();
    }

    private async Task CargarAsync() => agenda = AgendaTareas.Organizar(await Tareas.ListarAsync(), hoy);

    private IEnumerable<Indicador> Indicadores()
    {
        var ganadoEsteMes = ventas[^1].Monto;
        yield return new("En curso", Enteros(resumen!.MontoEnCurso), Icons.Material.Filled.TrendingUp);
        yield return new("Ganado este mes", Enteros(ganadoEsteMes), Icons.Material.Filled.EmojiEvents);
        yield return new("Tasa de cierre", resumen.TasaDeCierre is { } tasa ? tasa.ToString("P0", FormatoPeru.Cultura) : "—", Icons.Material.Filled.DonutLarge);
        yield return new("Oportunidades abiertas", resumen.CantidadEnCurso.ToString(), Icons.Material.Filled.ViewKanban);
        yield return new("Cotizaciones enviadas", cotizaciones.Count(c => c.Estado == EstadoCotizacion.Enviada).ToString(), Icons.Material.Filled.RequestQuote);
        yield return new("Tareas para hoy", agenda!.ParaHoy.Count.ToString(), Icons.Material.Filled.TaskAlt);
    }

    private string ClienteDe(Guid? empresaId, Guid? contactoId) =>
        (empresaId is { } e ? nombres.GetValueOrDefault(e) : null)
        ?? (contactoId is { } c ? nombres.GetValueOrDefault(c) : null)
        ?? "—";

    // Gráfico de línea, en porcentajes del área: el SVG se estira al ancho de la tarjeta y los
    // textos y puntos van en HTML encima, así conservan su tamaño en el celular y en la PC
    private double XDe(int indice) => 3 + 94.0 * indice / Math.Max(1, ventas.Count - 1);

    private double YDe(decimal monto) => 100 - (double)(monto / maximoMensual) * 100;

    private string RutaDeLaCurva() => string.Join(' ', ventas.Select((v, i) => $"{(i == 0 ? 'M' : 'L')}{Num(XDe(i))},{Num(YDe(v.Monto))}"));

    private static string Enteros(decimal monto) => monto.ToString("C0", FormatoPeru.Cultura);

    /// <summary>El tope del eje: 1, 2, 4 o 8 por una potencia de 10, para que las marcas queden en cifras redondas.</summary>
    private static decimal EscalaRedonda(decimal maximo)
    {
        var potencia = 1000m;
        while (potencia * 8 < maximo)
        {
            potencia *= 10;
        }

        return new[] { 1m, 2m, 4m, 8m }.Select(m => m * potencia).First(tope => tope >= maximo);
    }

    private static string Num(double valor) => valor.ToString("0.##", CultureInfo.InvariantCulture);

    private static string NombreMes(DateOnly mes) => mes.ToString("MMM", FormatoPeru.Cultura).TrimEnd('.');

    private static string Abreviar(decimal monto) => monto switch
    {
        >= 1_000_000 => $"S/ {(monto / 1_000_000).ToString("0.#", FormatoPeru.Cultura)}M",
        >= 1_000 => $"S/ {(monto / 1_000).ToString("0.#", FormatoPeru.Cultura)}k",
        _ => $"S/ {monto.ToString("0", FormatoPeru.Cultura)}",
    };

    // Dona de cotizaciones: un tramo de conic-gradient por estado
    private static string ColorDe(EstadoCotizacion estado) => estado switch
    {
        EstadoCotizacion.Aceptada => "#F2733A",
        EstadoCotizacion.Enviada => "#FFB38A",
        EstadoCotizacion.Rechazada => "#7A7A7A",
        _ => "#3F3F3F",
    };

    private string Dona()
    {
        var tramos = new List<string>();
        var acumulado = 0.0;
        foreach (var estado in EstadosCotizacion.Todos)
        {
            var parte = (double)cotizaciones.Count(c => c.Estado == estado) / cotizaciones.Count * 100;
            if (parte == 0)
            {
                continue;
            }

            tramos.Add($"{ColorDe(estado)} {Num(acumulado)}% {Num(acumulado + parte)}%");
            acumulado += parte;
        }

        return $"conic-gradient({string.Join(", ", tramos)})";
    }
}
