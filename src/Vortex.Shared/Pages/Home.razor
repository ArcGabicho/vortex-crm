@page "/"

<PageTitle>Inicio · Vortex CRM</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Bienvenido a Vortex CRM</MudText>
<MudText Typo="Typo.body1" Class="mb-6">
    El CRM para emprendedores peruanos: tus clientes, ventas y cotizaciones en un solo lugar.
</MudText>

<MudGrid>
    @foreach (var modulo in modulos)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1">
                <MudIcon Icon="@modulo.Icono" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-2">@modulo.Nombre</MudText>
                <MudText Typo="Typo.body2">@modulo.Descripcion</MudText>
                <MudChip T="string" Size="Size.Small" Class="mt-2 ml-0">Próximamente</MudChip>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private sealed record Modulo(string Nombre, string Descripcion, string Icono);

    private static readonly Modulo[] modulos =
    [
        new("Contactos", "Clientes y empresas con búsqueda por RUC o DNI.", Icons.Material.Filled.People),
        new("Pipeline", "Sigue cada oportunidad hasta cerrar la venta.", Icons.Material.Filled.ViewKanban),
        new("Cotizaciones", "En soles, con IGV y listas para enviar por WhatsApp.", Icons.Material.Filled.RequestQuote),
        new("Tareas", "Recordatorios para no perder ningún seguimiento.", Icons.Material.Filled.TaskAlt),
    ];
}
