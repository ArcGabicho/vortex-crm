@page "/contactos/nuevo"
@page "/contactos/{Id:guid}"
@inject IRepositorioContactos Repositorio
@inject IConsultaDocumentos ConsultaDocumentos
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IDialogService Dialogos
@inject IRepositorioOportunidades Oportunidades

<PageTitle>@Titulo · Vortex CRM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Titulo</MudText>

@if (noEncontrado)
{
    <MudAlert Severity="Severity.Warning">El contacto no existe o fue eliminado.</MudAlert>
}
else if (contacto is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" />
}
else
{
    @if (ConsultaDocumentos.EsDePrueba)
    {
        <MudAlert Severity="Severity.Info" Dense Class="mb-4">
            La consulta de DNI está en modo de prueba: los datos que se completan son inventados.
        </MudAlert>
    }

    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="DNI (opcional)" Value="contacto.Dni" ValueChanged="CambiarDniAsync" Immediate
                              MaxLength="8" InputMode="InputMode.numeric"
                              Error="@(errorDni is not null)" ErrorText="@errorDni"
                              HelperText="Al ingresar los 8 dígitos se completan nombres y apellidos"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                              OnAdornmentClick="BuscarDniAsync" AdornmentAriaLabel="Buscar DNI" />
                @if (buscando)
                {
                    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mt-1" />
                }
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid?" @bind-Value="contacto.EmpresaId" Label="Empresa">
                    <MudSelectItem T="Guid?" Value="@((Guid?)null)">Sin empresa</MudSelectItem>
                    @foreach (var empresa in empresas)
                    {
                        <MudSelectItem T="Guid?" Value="@empresa.Id">@empresa.NombreVisible</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="contacto.Nombres" Label="Nombres" Required />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="contacto.Apellidos" Label="Apellidos" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="contacto.Telefono" Label="Celular / WhatsApp" InputType="InputType.Telephone" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="contacto.Email" Label="Correo" InputType="InputType.Email" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="contacto.Cargo" Label="Cargo" />
            </MudItem>
        </MudGrid>

        @if (errores.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">
                @foreach (var error in errores)
                {
                    <div>@error</div>
                }
            </MudAlert>
        }

        <MudStack Row Wrap="Wrap.Wrap" Justify="Justify.FlexEnd" Class="mt-4">
            @if (Id is not null)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="EliminarAsync">Eliminar</MudButton>
            }
            <MudButton Variant="Variant.Text" Href="contactos">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GuardarAsync" Disabled="buscando">Guardar</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Contacto? contacto;
    private IReadOnlyList<Empresa> empresas = [];
    private bool noEncontrado;
    private bool buscando;
    private string? errorDni;
    private string? ultimoDniConsultado;
    private List<string> errores = [];

    private string Titulo => Id is null ? "Nuevo contacto" : "Editar contacto";

    protected override async Task OnParametersSetAsync()
    {
        empresas = await Repositorio.ListarEmpresasAsync();

        if (Id is null)
        {
            contacto = new Contacto();
            return;
        }

        contacto = await Repositorio.ObtenerContactoAsync(Id.Value);
        noEncontrado = contacto is null;
        ultimoDniConsultado = contacto?.Dni;
    }

    private async Task CambiarDniAsync(string? valor)
    {
        var dni = new string((valor ?? "").Where(char.IsAsciiDigit).ToArray());
        contacto!.Dni = dni.Length == 0 ? null : dni;
        errorDni = null;

        if (dni.Length == 8 && dni != ultimoDniConsultado)
        {
            await BuscarDniAsync();
        }
    }

    private async Task BuscarDniAsync()
    {
        if (!DocumentoIdentidad.EsDniValido(contacto!.Dni))
        {
            errorDni = "El DNI debe tener 8 dígitos.";
            return;
        }

        buscando = true;
        ultimoDniConsultado = contacto.Dni;
        try
        {
            var datos = await ConsultaDocumentos.ConsultarDniAsync(contacto.Dni!);
            if (datos is null)
            {
                Snackbar.Add("No se encontró el DNI. Completa los datos a mano.", Severity.Warning);
                return;
            }

            contacto.Nombres = datos.Nombres;
            contacto.Apellidos = datos.Apellidos;
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo consultar el DNI. Revisa tu conexión o completa los datos a mano.", Severity.Error);
        }
        finally
        {
            buscando = false;
        }
    }

    private async Task GuardarAsync()
    {
        errores = contacto!.Validar().ToList();
        if (errores.Count > 0)
        {
            return;
        }

        await Repositorio.GuardarContactoAsync(contacto);
        Snackbar.Add("Contacto guardado.", Severity.Success);
        Navegacion.NavigateTo("contactos");
    }

    private async Task EliminarAsync()
    {
        var cantidad = await Oportunidades.ContarDeClienteAsync(contacto!.Id);
        if (cantidad > 0)
        {
            Snackbar.Add(
                $"No se puede eliminar: tiene {cantidad} oportunidad(es) en el pipeline. Elimínalas o cámbialas de cliente primero.",
                Severity.Warning);
            return;
        }

        var confirmado = await Dialogos.ShowMessageBoxAsync(
            "Eliminar contacto",
            $"¿Eliminar a {contacto!.NombreCompleto}?",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmado == true)
        {
            await Repositorio.EliminarContactoAsync(contacto.Id);
            Snackbar.Add("Contacto eliminado.", Severity.Success);
            Navegacion.NavigateTo("contactos");
        }
    }
}
