@page "/contactos"
@inject IRepositorioContactos Repositorio

<PageTitle>Contactos · Vortex CRM</PageTitle>

<MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Contactos</MudText>
    <MudStack Row Wrap="Wrap.Wrap">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="contactos/nuevo">Nuevo contacto</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness"
                   Href="empresas/nueva">Nueva empresa</MudButton>
    </MudStack>
</MudStack>

<MudTextField T="string" Value="filtro" ValueChanged="FiltrarAsync" Immediate DebounceInterval="300" Clearable
              Placeholder="Buscar por nombre, RUC, DNI o teléfono" Variant="Variant.Outlined"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-4" />

<MudTabs Elevation="1" Rounded ApplyEffectsToContainer>
    <MudTabPanel Text="@($"Personas ({contactos.Count})")">
        @if (contactos.Count == 0)
        {
            <MudText Class="pa-4 mud-text-secondary">@MensajeVacio("contactos")</MudText>
        }
        else
        {
            <MudList T="string">
                @foreach (var contacto in contactos)
                {
                    <MudListItem T="string" Href="@($"contactos/{contacto.Id}")" Icon="@Icons.Material.Filled.Person">
                        <MudText Typo="Typo.body1">@contacto.NombreCompleto</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@DetalleContacto(contacto)</MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </MudTabPanel>

    <MudTabPanel Text="@($"Empresas ({empresas.Count})")">
        @if (empresas.Count == 0)
        {
            <MudText Class="pa-4 mud-text-secondary">@MensajeVacio("empresas")</MudText>
        }
        else
        {
            <MudList T="string">
                @foreach (var empresa in empresas)
                {
                    <MudListItem T="string" Href="@($"empresas/{empresa.Id}")" Icon="@Icons.Material.Filled.Business">
                        <MudText Typo="Typo.body1">@empresa.NombreVisible</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">RUC @empresa.Ruc</MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private string? filtro;
    private IReadOnlyList<Contacto> contactos = [];
    private IReadOnlyList<Empresa> empresas = [];
    private Dictionary<Guid, string> nombresEmpresas = [];

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task FiltrarAsync(string? valor)
    {
        filtro = valor;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        contactos = await Repositorio.ListarContactosAsync(filtro);
        empresas = await Repositorio.ListarEmpresasAsync(filtro);

        // Todas las empresas, no solo las filtradas, para mostrar la empresa de cada contacto
        var todas = string.IsNullOrWhiteSpace(filtro) ? empresas : await Repositorio.ListarEmpresasAsync();
        nombresEmpresas = todas.ToDictionary(e => e.Id, e => e.NombreVisible);
    }

    private string DetalleContacto(Contacto contacto)
    {
        var empresa = contacto.EmpresaId is { } id ? nombresEmpresas.GetValueOrDefault(id) : null;
        var partes = new[] { contacto.Cargo, empresa, contacto.Telefono }.Where(p => !string.IsNullOrWhiteSpace(p));
        return string.Join(" · ", partes);
    }

    private string MensajeVacio(string tipo) =>
        string.IsNullOrWhiteSpace(filtro) ? $"Todavía no tienes {tipo}." : $"No hay {tipo} que coincidan con \"{filtro}\".";
}
