@inject IRepositorioTareas Repositorio
@inject IRepositorioContactos Contactos
@inject IRepositorioOportunidades Oportunidades

@* Las tareas pendientes de una empresa, un contacto o una oportunidad, en su pantalla de edición *@
<MudPaper Class="pa-4 mt-4" Elevation="1" data-tareas-de>
    <MudStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h6">Tareas</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddTask"
                   Href="@($"tareas/nueva?{Parametro}={RelacionadoId}")">Nueva tarea</MudButton>
    </MudStack>

    @if (pendientes is null)
    {
        <MudProgressLinear Indeterminate Color="Color.Primary" />
    }
    else if (pendientes.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            No hay tareas pendientes.@(completadas > 0 ? $" {Plural(completadas)} ya {(completadas == 1 ? "está hecha" : "están hechas")}." : "")
        </MudText>
    }
    else
    {
        <ListaTareas Tareas="pendientes" Nombres="nombres" Contexto="RelacionadoId" Volver="@Volver" AlCambiar="CargarAsync" />
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid RelacionadoId { get; set; }

    /// <summary>Con qué nombre se pasa el Id a la tarea nueva: "empresa", "contacto" u "oportunidad".</summary>
    [Parameter, EditorRequired] public string Parametro { get; set; } = "";

    /// <summary>La pantalla actual, para regresar a ella después de editar una tarea.</summary>
    [Parameter, EditorRequired] public string Volver { get; set; } = "";

    private IReadOnlyList<Tarea>? pendientes;
    private int completadas;
    private IReadOnlyDictionary<Guid, string> nombres = new Dictionary<Guid, string>();

    protected override async Task OnParametersSetAsync()
    {
        nombres = await NombresDeRegistros.CargarAsync(Contactos, Oportunidades);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var tareas = await Repositorio.ListarDeAsync(RelacionadoId);
        pendientes = tareas.Where(t => !t.Completada).ToList();
        completadas = tareas.Count - pendientes.Count;
    }

    private static string Plural(int cantidad) => cantidad == 1 ? "Una tarea" : $"{cantidad} tareas";
}
