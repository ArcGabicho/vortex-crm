@* Los errores de validación de un formulario, uno por línea *@
@if (Lista.Count > 0)
{
    <MudAlert Severity="Severity.Error" Class="mt-4" data-errores>
        @foreach (var error in Lista)
        {
            <div>@error</div>
        }
    </MudAlert>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Lista { get; set; } = [];
}
