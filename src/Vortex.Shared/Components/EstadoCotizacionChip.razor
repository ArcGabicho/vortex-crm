<MudChip T="string" Size="Size.Small" Color="@ColorDelEstado" Variant="Variant.Text" Class="ma-0">@Estado</MudChip>

@code {
    [Parameter, EditorRequired] public EstadoCotizacion Estado { get; set; }

    private Color ColorDelEstado => Estado switch
    {
        EstadoCotizacion.Enviada => Color.Info,
        EstadoCotizacion.Aceptada => Color.Success,
        EstadoCotizacion.Rechazada => Color.Error,
        _ => Color.Default,
    };
}
