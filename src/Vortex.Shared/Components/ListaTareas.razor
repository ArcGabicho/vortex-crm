@inject IRepositorioTareas Repositorio
@inject ISnackbar Snackbar

@* Filas de tareas con su casilla para marcarlas como hechas *@
<div class="lista-tareas">
    @foreach (var tarea in Tareas)
    {
        var vencida = tarea.EstaVencida(hoy);
        <div class="vx-tarea @(tarea.Completada ? "vx-tarea-hecha" : null)" data-tarea="@tarea.Titulo">
            <MudCheckBox T="bool" Value="tarea.Completada" ValueChanged="@(hecha => CambiarAsync(tarea, hecha))"
                         Color="Color.Primary" Dense Class="vx-tarea-check" AriaLabel="@($"Marcar \"{tarea.Titulo}\" como hecha")" />
            <span class="vx-tarea-icono" title="@tarea.Tipo.Nombre()"><MudIcon Icon="@Icono(tarea.Tipo)" Size="Size.Small" /></span>
            <div class="vx-tarea-texto">
                <a href="@Enlace(tarea)" class="vx-tarea-titulo">@tarea.Titulo</a>
                @if (Detalle(tarea) is { Length: > 0 } detalle)
                {
                    <span class="vx-tarea-detalle">@detalle</span>
                }
            </div>
            <span class="vx-tarea-cuando @(vencida ? "vx-vencida" : null)" data-cuando>@Cuando(tarea)</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Tarea> Tareas { get; set; } = [];

    /// <summary>Nombres de empresas, contactos y oportunidades por Id (ver <see cref="NombresDeRegistros"/>).</summary>
    [Parameter] public IReadOnlyDictionary<Guid, string> Nombres { get; set; } = new Dictionary<Guid, string>();

    /// <summary>El registro de la pantalla donde se muestra la lista: su nombre no se repite en cada tarea.</summary>
    [Parameter] public Guid? Contexto { get; set; }

    /// <summary>A dónde regresar después de editar una tarea (ver <c>TareaEditar</c>).</summary>
    [Parameter] public string? Volver { get; set; }

    /// <summary>Se llama después de marcar o desmarcar una tarea, para que la pantalla recargue.</summary>
    [Parameter] public EventCallback AlCambiar { get; set; }

    private readonly DateOnly hoy = FormatoPeru.Hoy();

    public static string Icono(TipoTarea tipo) => tipo switch
    {
        TipoTarea.Llamada => Icons.Material.Filled.Phone,
        TipoTarea.WhatsApp => Icons.Custom.Brands.WhatsApp,
        TipoTarea.Reunion => Icons.Material.Filled.Groups,
        TipoTarea.Visita => Icons.Material.Filled.Place,
        TipoTarea.Correo => Icons.Material.Filled.Email,
        _ => Icons.Material.Filled.TaskAlt,
    };

    private string Enlace(Tarea tarea) =>
        Volver is null ? $"tareas/{tarea.Id}" : $"tareas/{tarea.Id}?volver={Uri.EscapeDataString(Volver)}";

    private string Cuando(Tarea tarea)
    {
        var fecha = FormatoPeru.FechaRelativa(tarea.Fecha, hoy);
        return tarea.Hora is { } hora ? $"{fecha}, {FormatoPeru.Hora(hora)}" : fecha;
    }

    private string Detalle(Tarea tarea)
    {
        var relacionados = new[] { tarea.EmpresaId, tarea.ContactoId, tarea.OportunidadId }
            .Where(id => id is not null && id != Contexto)
            .Select(id => Nombres.GetValueOrDefault(id!.Value));
        return string.Join(" · ", relacionados.Where(n => !string.IsNullOrWhiteSpace(n)));
    }

    private async Task CambiarAsync(Tarea tarea, bool hecha)
    {
        if (hecha)
        {
            tarea.Completar(DateTimeOffset.UtcNow);
        }
        else
        {
            tarea.Reabrir();
        }

        await Repositorio.GuardarAsync(tarea);
        await AlCambiar.InvokeAsync();

        if (hecha)
        {
            Snackbar.Add($"Hecho: {tarea.Titulo}", Severity.Success, opciones =>
            {
                opciones.Action = "Deshacer";
                opciones.OnClick = _ => CambiarAsync(tarea, false);
            });
        }
    }
}
