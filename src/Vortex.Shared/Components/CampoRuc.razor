@* Campo de RUC que valida el dígito verificador y consulta los datos de SUNAT al completar los 11 dígitos *@
@inject IConsultaDocumentos ConsultaDocumentos
@inject ISnackbar Snackbar

<MudTextField T="string" Label="@Label" Value="Ruc" ValueChanged="CambiarAsync" Immediate
              MaxLength="11" InputMode="InputMode.numeric" Required="Requerido"
              Error="@(error is not null)" ErrorText="@error"
              HelperText="Al ingresar los 11 dígitos se completan los datos de SUNAT"
              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
              OnAdornmentClick="BuscarDesdeBotonAsync" AdornmentAriaLabel="Buscar RUC" />
@if (buscando)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="mt-1" />
}

@code {
    [Parameter] public string? Ruc { get; set; }

    [Parameter] public EventCallback<string?> RucChanged { get; set; }

    /// <summary>Se dispara con los datos de SUNAT cuando se encuentra el RUC.</summary>
    [Parameter] public EventCallback<DatosRuc> Encontrado { get; set; }

    /// <summary>Indica si hay una consulta en curso, para deshabilitar el botón Guardar mientras tanto.</summary>
    [Parameter] public bool Buscando { get; set; }

    [Parameter] public EventCallback<bool> BuscandoChanged { get; set; }

    [Parameter] public string Label { get; set; } = "RUC";

    [Parameter] public bool Requerido { get; set; }

    private bool buscando;
    private string? error;
    private string? ultimoConsultado;
    private bool inicializado;

    protected override void OnParametersSet()
    {
        // El RUC con el que se abre el formulario ya fue consultado al registrarlo
        if (!inicializado)
        {
            ultimoConsultado = Ruc;
            inicializado = true;
        }
    }

    private async Task CambiarAsync(string? valor)
    {
        var ruc = new string((valor ?? "").Where(char.IsAsciiDigit).ToArray());
        error = null;
        await RucChanged.InvokeAsync(ruc);

        if (ruc.Length == 11 && ruc != ultimoConsultado)
        {
            await BuscarAsync(ruc);
        }
    }

    private Task BuscarDesdeBotonAsync() => BuscarAsync(Ruc ?? "");

    private async Task BuscarAsync(string ruc)
    {
        if (!DocumentoIdentidad.EsRucValido(ruc))
        {
            error = "El RUC no es válido: revisa que tenga 11 dígitos y el dígito verificador.";
            return;
        }

        buscando = true;
        ultimoConsultado = ruc;
        await BuscandoChanged.InvokeAsync(true);
        try
        {
            var datos = await ConsultaDocumentos.ConsultarRucAsync(ruc);
            if (datos is null)
            {
                Snackbar.Add("No se encontró el RUC. Completa los datos a mano.", Severity.Warning);
                return;
            }

            await Encontrado.InvokeAsync(datos);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo consultar el RUC. Revisa tu conexión o completa los datos a mano.", Severity.Error);
        }
        finally
        {
            buscando = false;
            await BuscandoChanged.InvokeAsync(false);
        }
    }
}
