@* Campo para elegir el distrito: se busca por nombre y guarda el código de ubigeo del INEI *@
@inject CatalogoUbigeos Ubigeos

<div class="vx-campo-ubigeo" data-campo-ubigeo>
    <MudAutocomplete T="Ubigeo" Label="@Label" Value="seleccionado" ValueChanged="CambiarAsync"
                     SearchFunc="BuscarAsync" ToStringFunc="@(u => u?.Descripcion)" MaxItems="null"
                     MinCharacters="2" DebounceInterval="150" Clearable ResetValueOnEmptyText
                     HelperText="@HelperText" AdornmentIcon="@Icons.Material.Filled.Place">
        <ItemTemplate>
            <div class="vx-ubigeo-opcion">
                <span>@context.Distrito</span>
                <small>@context.Provincia · @context.Departamento</small>
            </div>
        </ItemTemplate>
        <NoItemsTemplate>
            <div class="vx-ubigeo-vacio">No hay distritos con ese nombre.</div>
        </NoItemsTemplate>
    </MudAutocomplete>
</div>

@code {
    /// <summary>Código de ubigeo del distrito elegido, o <c>null</c> si no se eligió ninguno.</summary>
    [Parameter] public string? Codigo { get; set; }

    [Parameter] public EventCallback<string?> CodigoChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Distrito";

    [Parameter] public string? HelperText { get; set; } = "Escribe el distrito; para separar los del mismo nombre, agrega la provincia";

    private Ubigeo? seleccionado;

    protected override void OnParametersSet() => seleccionado = Ubigeos.Obtener(Codigo);

    private Task<IEnumerable<Ubigeo>> BuscarAsync(string? texto, CancellationToken cancelacion) =>
        Task.FromResult<IEnumerable<Ubigeo>>(Ubigeos.Buscar(texto));

    private async Task CambiarAsync(Ubigeo? ubigeo)
    {
        seleccionado = ubigeo;
        await CodigoChanged.InvokeAsync(ubigeo?.Codigo);
    }
}
