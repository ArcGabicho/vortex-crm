@* Diálogo para elegir un producto del catálogo al armar una cotización *@
@using Vortex.Domain.Catalogo
@inject IRepositorioProductos Repositorio
@inject NavigationManager Navegacion

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Value="filtro" ValueChanged="FiltrarAsync" Immediate DebounceInterval="200" Clearable AutoFocus
                      Placeholder="Buscar producto o servicio" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-2" />

        @if (productos is null)
        {
            <MudProgressLinear Indeterminate Color="Color.Primary" />
        }
        else if (productos.Count == 0)
        {
            <MudText Class="mud-text-secondary my-4">
                @(string.IsNullOrWhiteSpace(filtro) ? "Tu catálogo está vacío." : $"No hay productos que coincidan con \"{filtro}\".")
            </MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="IrANuevoProducto">Registrar un producto</MudButton>
        }
        else
        {
            <MudList T="string" Dense Style="max-height: 50vh; overflow-y: auto">
                @foreach (var producto in productos)
                {
                    <MudListItem T="string" OnClick="() => Elegir(producto)" data-elegir-producto="@producto.Nombre">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="1">
                            <div>
                                <MudText Typo="Typo.body1">@producto.Nombre</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @(string.IsNullOrWhiteSpace(producto.Codigo) ? "" : $"{producto.Codigo} · ")por @producto.Unidad
                                </MudText>
                            </div>
                            <MudText Typo="Typo.body1"><b>@FormatoPeru.Soles(producto.PrecioPara(ModoIgv))</b></MudText>
                        </MudStack>
                    </MudListItem>
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialogo { get; set; } = default!;

    /// <summary>Modo de IGV de la cotización: los precios se muestran ya convertidos.</summary>
    [Parameter] public ModoIgv ModoIgv { get; set; }

    private string? filtro;
    private IReadOnlyList<Producto>? productos;

    protected override async Task OnInitializedAsync() => productos = await Repositorio.ListarAsync();

    private async Task FiltrarAsync(string? valor)
    {
        filtro = valor;
        productos = await Repositorio.ListarAsync(filtro);
    }

    private void Elegir(Producto producto) => Dialogo.Close(DialogResult.Ok(producto));

    private void Cancelar() => Dialogo.Cancel();

    private void IrANuevoProducto()
    {
        Dialogo.Cancel();
        Navegacion.NavigateTo("productos/nuevo");
    }
}
